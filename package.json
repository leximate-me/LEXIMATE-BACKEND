{
  "name": "leximate-backend",
  "version": "1.0.0",
  "description": "",
  "main": "build/index.js",
  "type": "commonjs",
  "scripts": {
    "load:workflows": "tsx scripts/load-n8n-workflows.ts",
    "load:credentials": "tsx scripts/load-n8n-credentials.ts",
    "load:all": "npm run load:credentials && npm run load:workflows",
    "start:dev": "nodemon",
    "start:build": "swc src -d dist && tsc-alias -p tsconfig.json",
    "start:prod": "node dist/index.js",
    "docker:load:workflows": "docker-compose exec backend npm run load:workflows",
    "docker:load:credentials": "docker-compose exec backend npm run load:credentials",
    "docker:load:all": "docker-compose exec backend npm run load:all",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down -v",
    "docker:build": "docker-compose build --no-cache",
    "docker:rebuild": "npm run docker:down && npm run docker:build && npm run docker:up",
    "docker:logs": "docker-compose logs -f",
    "docker:logs:backend": "docker-compose logs -f backend",
    "docker:logs:postgres": "docker-compose logs -f postgres",
    "docker:logs:n8n": "docker-compose logs -f n8n",
    "docker:db:up": "docker-compose up -d postgres",
    "docker:db:down": "docker-compose down postgres",
    "docker:db:reset": "docker-compose down postgres && docker volume rm leximate-backend_postgres_data && docker-compose up -d postgres",
    "docker:db:shell": "docker-compose exec postgres psql -U postgres -d leximate",
    "docker:n8n:up": "docker-compose up -d n8n",
    "docker:n8n:down": "docker-compose down n8n",
    "docker:n8n:reset": "docker-compose down n8n && docker volume rm leximate-backend_n8n_data && docker-compose up -d n8n",
    "docker:backend:up": "docker-compose up -d backend",
    "docker:backend:down": "docker-compose down backend",
    "docker:backend:restart": "docker-compose restart backend",
    "docker:backend:rebuild": "docker-compose build --no-cache backend && docker-compose up -d backend",
    "docker:clean": "docker-compose down -v && docker system prune -f",
    "docker:status": "docker-compose ps",
    "docker:shell:backend": "docker-compose exec backend sh",
    "docker:shell:postgres": "docker-compose exec postgres sh",
    "docker:restart": "docker-compose restart",
    "docker:stop": "docker-compose stop"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.918.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/env": "^5.0.3",
    "@fastify/multipart": "^9.3.0",
    "@fastify/static": "^8.3.0",
    "@types/pdf-parse": "^1.1.5",
    "ajv-errors": "^3.0.0",
    "aws-sdk": "^2.1692.0",
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "env-var": "^7.5.0",
    "express": "^4.21.1",
    "fastify": "^5.6.1",
    "figlet": "^1.8.0",
    "form-data": "^4.0.4",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^3.3.2",
    "pdf-parse": "^2.4.5",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^4.0.1-alpha.0",
    "tesseract.js": "^5.1.1",
    "typeorm": "^0.3.27",
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "@swc/cli": "^0.7.9",
    "@swc/core": "^1.15.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/figlet": "^1.7.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^24.9.1",
    "nodemon": "^3.1.7",
    "pino": "^10.1.0",
    "pino-colada": "^2.2.2",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.2",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tslib": "^2.8.1",
    "tsx": "^4.20.6",
    "typescript": "^5.6.3"
  }
}
