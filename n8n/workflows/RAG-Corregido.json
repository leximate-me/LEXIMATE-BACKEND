    {
      "parameters": {
        "jsCode": "const items = [];\n\nfor (const item of $input.all()) {\n  const json = item.json;\n  const info = json.info ?? {};\n  const metadata = json.metadata ?? {};\n\n  // Normalizamos claves de metadata (reemplaza \":\" por \"_\")\n  const normalized = Object.fromEntries(\n    Object.entries(metadata).map(([k, v]) => [k.replace(':', '_'), v])\n  );\n\n  const outputJson = {\n    // Info principal\n    creationDate: info.CreationDate ?? null,\n    creator: info.Creator ?? null,\n    modDate: info.ModDate ?? null,\n    producer: info.Producer ?? null,\n    language: info.Language ?? null,\n\n    // Metadata XMP normalizada\n    xmpCreateDate: normalized.xmp_createdate ?? null,\n    xmpCreatorTool: normalized.xmp_creatortool ?? null,\n    xmpModifyDate: normalized.xmp_modifydate ?? null,\n    xmpMetadataDate: normalized.xmp_metadatadate ?? null,\n    pdfProducer: normalized.pdf_producer ?? null,\n    dcFormat: normalized.dc_format ?? null,\n    xmpmmDocumentId: normalized.xmpmm_documentid ?? null,\n    xmpmmInstanceId: normalized.xmpmm_instanceid ?? null,\n\n    // Texto extraído\n    text: json.text ?? null,\n  };\n\n  items.push({ json: outputJson });\n}\n\nreturn items;\n"
      },
